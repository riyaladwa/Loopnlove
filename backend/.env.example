# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB instance: mongodb://localhost:27017/loop_n_love
# Production: mongodb+srv://<username>:<password>@cluster.mongodb.net/loop_n_love
MONGODB_URI=mongodb://localhost:27017/loop_n_love

# Security & Authentication
JWT_SECRET=loop_n_love_secure_jwt_secret_dev_key_2026
JWT_EXPIRES_IN=7d

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5000

# WhatsApp Integration (Configurable business number with country code, e.g. 919876543210)
BUSINESS_WHATSAPP_NUMBER=

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Direct UPI & Google Pay Settings
UPI_ID=your_upi_id@bank
UPI_PAYEE_NAME=Your Store Name
UPI_QR_IMAGE=/assets/payments/google-pay-qr.jpg

# Automatic Admin WhatsApp Notification (Meta WhatsApp Business Cloud API)
ADMIN_WHATSAPP_NUMBER=919876543210
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id

# Cloudinary Image Hosting
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


